{
  "name": "x32-fernsteuerung",
  "version": "2.12.0",
  "description": "Fernsteuerung für das Behringer X32 (Fader, EQ, Kompressor, Pegel) für Mac und Windows",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "build:win": "electron-builder --win --publish never",
    "test:net": "node test/net-test.js",
    "test:smoke": "node test/smoke-ci.js"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "de.technikag.x32fernsteuerung",
    "productName": "X32 Fernsteuerung",
    "files": [
      "main.js",
      "preload.js",
      "shared/**/*",
      "renderer/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "X32-Fernsteuerung.${ext}",
      "identity": null,
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Für die Pegelmessung (dB-Meter) mit dem Messmikrofon am Audio-Interface.",
        "NSLocalNetworkUsageDescription": "X32 Fernsteuerung verbindet sich über das lokale Netzwerk mit dem X32/M32-Pult (UDP, Port 10023) und sucht Pulte im Netz."
      }
    },
    "afterSign": "scripts/afterSignAdHoc.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "X32-Fernsteuerung-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "X32 Fernsteuerung",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
